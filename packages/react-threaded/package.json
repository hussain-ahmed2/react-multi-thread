{
  "name": "react-threaded",
  "version": "0.1.0",
  "description": "Typed Web Workers for React: hooks, cancellable tasks, worker pools, shared atomics, plugins, and Comlink-style proxies.",
  "keywords": [
    "react",
    "web-worker",
    "worker",
    "worker-pool",
    "multithreading",
    "concurrency",
    "shared-array-buffer",
    "atomics",
    "typescript",
    "hooks"
  ],
  "license": "MIT",
  "author": "Hussain Ahmed",
  "homepage": "https://hussain-ahmed2.github.io/react-threaded/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussain-ahmed2/react-threaded.git",
    "directory": "packages/react-threaded"
  },
  "bugs": {
    "url": "https://github.com/hussain-ahmed2/react-threaded/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
